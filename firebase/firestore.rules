rules_version = '2';

// Waffra deployment baseline: DENY ALL financial cloud reads/writes.
// This rule set is intentionally restrictive until:
//  1) Firestore is provisioned in the verified Saudi region by the owner,
//  2) Flutter client-side encrypted sync and recoverable keys are implemented,
//  3) explicit per-vault consent and account ownership are checked,
//  4) emulator rules tests confirm all isolation and denial cases,
//  5) production PDPL/legal/privacy review is approved.
//
// Signing in with Google NEVER permits the financial database to be read
// or written merely by virtue of being authenticated.
// Do not replace with "allow read, write: if request.auth != null".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
